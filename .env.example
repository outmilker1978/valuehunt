# ValueHunt Configuration
# Copy this file to .env and fill in your values

# HeadHunter API (required for scanning)
# How to get: https://dev.hh.ru/ → register application → OAuth token
HH_ACCESS_TOKEN=your_hh_access_token_here

# DeepSeek API (optional, for LLM analysis)
# Get at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Telegram Bot (optional, for notifications)
# Create via @BotFather on Telegram, then fill:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
